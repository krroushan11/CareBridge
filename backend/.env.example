# Existing application configuration
PORT=5000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=carebridge_ai
DB_USER=postgres
DB_PASSWORD=
# Generate a unique random value with at least 32 characters.
JWT_SECRET=
JWT_EXPIRES_IN=1d
EMAIL_USER=
EMAIL_PASS=
EMAIL_REMINDERS_ENABLED=false
REMINDER_INTERVAL_MS=60000

# OpenAI-compatible chat provider, or Gemini native embeddings when using
# https://generativelanguage.googleapis.com/v1beta/openai/
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
# For Gemini, set AI_EMBEDDING_MODEL=gemini-embedding-001.
